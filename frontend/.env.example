# Address of the deployed OpenBrief contract on GenLayer Studionet.
# Optional: the current Studionet address is hard-coded as the default in
# src/lib/config.ts, so the app works on a fresh checkout. A VITE_ override
# wins when set (local .env.local or the Vercel dashboard).
#
# There is NO private key here and there must never be one. Anything prefixed
# VITE_ is compiled into the public bundle. MetaMask signs every write.

VITE_CONTRACT_ADDRESS=
